{
  "name": "@nitro-bolt/packager",
  "version": "1.1.0",
  "packageManager": "pnpm@10.33.0",
  "description": "Converts projects into HTML files, zip archives, or executable programs for Windows, macOS, and Linux.",
  "main": "dist/packager.js",
  "scripts": {
    "start": "rspack dev",
    "clean": "rimraf dist",
    "build": "pnpm run clean && rspack build",
    "build-prod": "cross-env NODE_ENV=production pnpm run build",
    "watch": "rspack build --watch",
    "build-standalone": "cross-env STANDALONE=1 pnpm run build && node src/build/generate-standalone.js",
    "build-standalone-prod": "cross-env NODE_ENV=production pnpm run build-standalone",
    "build-node": "cross-env BUILD_MODE=node pnpm run build",
    "build-node-prod": "cross-env NODE_ENV=production pnpm run build-node",
    "test": "jest",
    "prepublishOnly": "pnpm run test && pnpm run build-node-prod && node src/build/nodejs/update-readme.js node",
    "postpublish": "node src/build/nodejs/update-readme.js restore"
  },
  "author": "GarboMuffin",
  "homepage": "https://github.com/Nitro-Bolt/packager#readme",
  "keywords": [
    "scratch",
    "packager"
  ],
  "bugs": {
    "url": "https://github.com/Nitro-Bolt/packager/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nitro-Bolt/packager.git"
  },
  "license": "MPL-2.0",
  "dependencies": {
    "@fiahfy/icns": "^0.0.7",
    "@turbowarp/json": "^0.1.1",
    "@turbowarp/jszip": "^3.11.0",
    "@turbowarp/sbdl": "^7.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "cross-fetch": "^4.1.0",
    "sha.js": "^2.4.11"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@nitro-bolt/scratch-storage": "^1.0.1",
    "@rspack/cli": "^2.1.1",
    "@rspack/core": "^2.1.1",
    "@rspack/dev-server": "^2.1.1",
    "@turbowarp/scratch-svg-renderer": "^1.1.0",
    "babel-jest": "^27.4.5",
    "babel-loader": "^10.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^27.4.5",
    "rimraf": "^2.7.1",
    "scratch-audio": "github:TurboWarp/scratch-audio#develop",
    "scratch-render": "github:Nitro-Bolt/scratch-render#develop",
    "scratch-render-fonts": "github:TurboWarp/scratch-render-fonts#master",
    "scratch-vm": "github:Nitro-Bolt/scratch-vm#develop",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "svelte": "^3.44.3",
    "svelte-loader": "^3.1.2",
    "webpack-bundle-analyzer": "^4.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
